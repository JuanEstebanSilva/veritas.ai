# URL base de la API
VITE_API_BASE_URL=http://localhost:5000/api

# API Key del cliente «Frontend Web Plagelio» (Lab 6).
# Debe coincidir con API_KEY_WEB del backend. Este archivo va al repositorio,
# así que aquí nunca se escribe la clave real: cópialo a .env y rellénalo.
# Ojo: en una aplicación web la clave termina dentro del bundle del navegador;
# identifica a la aplicación, no es un secreto. La persona se identifica con JWT.
VITE_API_KEY=REEMPLAZAR_CON_API_KEY_WEB
