          "name": "3. Registro de Paciente (201 Created)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var ts = Date.now();",
                  "pm.environment.set('timestamp', ts);",
                  "pm.collectionVariables.set('timestamp', ts);",
                  "var day = String((ts % 25) + 1).padStart(2, '0');",
                  "var hour = String((Math.floor(ts / 1000) % 10) + 8).padStart(2, '0');",
                  "var min = String(Math.floor(ts / 100) % 60).padStart(2, '0');",
                  "pm.environment.set('fechaCita', '2027-11-' + day);",
                  "pm.collectionVariables.set('fechaCita', '2027-11-' + day);",
                  "pm.environment.set('horaCita', hour + ':' + min + ':00');",
                  "pm.collectionVariables.set('horaCita', hour + ':' + min + ':00');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.environment.set('tokenPaciente', res.token);",
                  "    pm.collectionVariables.set('tokenPaciente', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
