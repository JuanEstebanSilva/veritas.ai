PORT=5000
NODE_ENV=development

# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/plagelio?schema=public"

# Autenticación JWT y Clave Maestra de Criptografía
JWT_SECRET="plagelio_super_secret_jwt_token_key_change_in_production_998811"
JWT_EXPIRES_IN="7d"
SECRET_ENCRYPTION_KEY="tu_clave_maestra_de_cifrado_aes256gcm"

# Administrador Inicial Único (creado mediante seed/variables de entorno seguras)
ADMIN_NAME="Administrador"
ADMIN_LAST_NAME="Sistema"
ADMIN_EMAIL="admin@plagelio.com"
ADMIN_PASSWORD="Admin123!Secure*"

# Pasarela de Pagos Stripe (Modo Prueba / Test Mode)
# Puedes usar una clave de prueba de Stripe o probar con el sandbox integrado
STRIPE_SECRET_KEY="sk_test_placeholder_key"
STRIPE_WEBHOOK_SECRET="whsec_placeholder_secret"

# URL del Frontend (CORS)
FRONTEND_URL="http://localhost:5173"

# ============================================================================
# Inteligencia Artificial y Humanizador de Texto
# ============================================================================
# Si no se suministra ninguna API Key, opera en Modo Heurístico Estilístico Offline
AI_PROVIDER="demo" # "openai" | "gemini" | "demo"
AI_MODEL="" # Ejemplos: "gpt-4o-mini", "gpt-4o", "gemini-1.5-flash", "gemini-1.5-pro"
AI_TEMPERATURE=0.75 # Rango recomendado: 0.70 a 0.85 para reescritura natural y variada

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=""

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""

# ============================================================================
# Búsqueda Web en Vivo y Detección de Plagio Real
# ============================================================================
# Proveedor principal: "google" | "tavily" | "serper" | "auto"
# En modo "auto", el sistema prueba primero Google Custom Search, luego Tavily/Serper,
# y finalmente fuentes académicas abiertas (Crossref, OpenAlex).
SEARCH_PROVIDER="auto"

# 1. Google Custom Search JSON API (Recomendado - 100 consultas/día gratuitas)
# Obtén tu API Key en: https://console.cloud.google.com/apis/credentials (Habilita Custom Search API)
GOOGLE_SEARCH_API_KEY=""
# Crea tu motor de búsqueda programable en: https://programmablesearchengine.google.com/
# (En "Sitios que buscar", activa la opción "Buscar en toda la Web")
GOOGLE_SEARCH_CX=""

# 2. Tavily Search API (Alternativa optimizada para IA y búsqueda profunda: https://tavily.com)
TAVILY_API_KEY=""

# 3. Serper API (Alternativa rápida de Google SERP: https://serper.dev)
SERPER_API_KEY=""

# ============================================================================
# API Key de Seguridad (Lab 5 - BLOQUE 3)
# ============================================================================
# Autentica al CLIENTE que consume la API (no al usuario final: eso es el JWT).
# Se envia en cada peticion a /api/* con la cabecera:  X-API-Key: <clave>
# Generala con un generador criptograficamente seguro, NUNCA a mano:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Este archivo SI va al repositorio, por lo que aqui nunca se escribe la clave real.
API_KEY="REEMPLAZAR_CON_API_KEY_SEGURA"

