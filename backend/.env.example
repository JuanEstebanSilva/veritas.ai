PORT=5000
NODE_ENV=development

# Base de datos PostgreSQL / Supabase
# Cadena de conexión al Transaction Pooler de Supabase (puerto 6543 o sesión directa 5432):
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# O conexión directa local para desarrollo:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/plagelio?schema=public"

# Prisma: conexión directa (sin pooler) para migraciones. En local, igual que DATABASE_URL.
DIRECT_URL=""

# TLS hacia PostgreSQL: se verifica el certificado por defecto con la CA de Supabase
# (certs/prod-ca-2021.crt, «Supabase Root 2021 CA»). Si tu proyecto usa otra CA, descárgala en
# Supabase > Project Settings > Database > SSL Configuration y reemplaza ese archivo.
# Solo para una base local con certificado autofirmado se puede desactivar (nunca en producción):
# PGSSL_REJECT_UNAUTHORIZED=false

# Usuario demo del seed. Si se deja vacío, el seed genera una contraseña aleatoria y la imprime una vez.
DEMO_PASSWORD=""

# Límite de intentos de inicio de sesión por IP y correo
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15

# Pago simulado (activa premium sin cobro). Nunca existe con NODE_ENV=production;
# en desarrollo se puede apagar con false.
PAYMENTS_SANDBOX=true

# Autenticación JWT y Clave Maestra de Criptografía
JWT_SECRET="REEMPLAZAR_CON_SECRETO_JWT_SEGURO"
JWT_EXPIRES_IN="1h"
SECRET_ENCRYPTION_KEY="tu_clave_maestra_de_cifrado_aes256gcm"

# Administrador Inicial Único (creado mediante bootstrap/variables de entorno seguras)
ADMIN_NOMBRE="Administrador Plagelio"
ADMIN_NAME="Administrador Plagelio"
ADMIN_LAST_NAME="Sistema"
ADMIN_EMAIL="admin@plagelio.com"
ADMIN_PASSWORD="REEMPLAZAR_CON_PASSWORD_SEGURO"

# Pasarela de Pagos Stripe (Modo Prueba / Test Mode)
# Puedes usar una clave de prueba de Stripe o probar con el sandbox integrado
STRIPE_SECRET_KEY="sk_test_placeholder_key"
STRIPE_WEBHOOK_SECRET="whsec_placeholder_secret"

# URL del Frontend (CORS)
FRONTEND_URL="http://localhost:5173"

# ============================================================================
# Inteligencia Artificial y Humanizador de Texto
# ============================================================================
# Si no se suministra ninguna API Key, opera en Modo Heurístico Estilístico Offline
AI_PROVIDER="demo" # "openai" | "gemini" | "demo"
AI_MODEL="" # Ejemplos: "gpt-4o-mini", "gpt-4o", "gemini-1.5-flash", "gemini-1.5-pro"
AI_TEMPERATURE=0.75 # Rango recomendado: 0.70 a 0.85 para reescritura natural y variada

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=""

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""

# ============================================================================
# Búsqueda Web en Vivo y Detección de Plagio Real
# ============================================================================
# Proveedor principal: "google" | "tavily" | "serper" | "auto"
# En modo "auto", el sistema prueba primero Google Custom Search, luego Tavily/Serper,
# y finalmente fuentes académicas abiertas (Crossref, OpenAlex).
SEARCH_PROVIDER="auto"

# 1. Google Custom Search JSON API (Recomendado - 100 consultas/día gratuitas)
# Obtén tu API Key en: https://console.cloud.google.com/apis/credentials (Habilita Custom Search API)
GOOGLE_SEARCH_API_KEY=""
# Crea tu motor de búsqueda programable en: https://programmablesearchengine.google.com/
# (En "Sitios que buscar", activa la opción "Buscar en toda la Web")
GOOGLE_SEARCH_CX=""

# 2. Tavily Search API (Alternativa optimizada para IA y búsqueda profunda: https://tavily.com)
TAVILY_API_KEY=""

# 3. Serper API (Alternativa rápida de Google SERP: https://serper.dev)
SERPER_API_KEY=""

# ============================================================================
# API Keys por cliente (Labs 5 y 6)
# ============================================================================
# Cada aplicación que consume la API tiene su PROPIA clave: así el servidor sabe
# qué cliente hizo cada petición y puede revocar a uno sin afectar a los demás.
# El servidor solo guarda el hash SHA-256 de cada clave (tabla api_clients).
#
# Se envían en cada petición a /api/* con la cabecera:  X-API-Key: <clave>
# Genera cada una con un generador criptográficamente seguro, NUNCA a mano:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Si falta cualquiera de las tres, el servidor se niega a arrancar.
# Este archivo SÍ va al repositorio, por lo que aquí nunca se escriben las claves reales.
API_KEY_POSTMAN="REEMPLAZAR_CON_API_KEY_SEGURA"
API_KEY_ADMIN="REEMPLAZAR_CON_API_KEY_SEGURA"
API_KEY_WEB="REEMPLAZAR_CON_API_KEY_SEGURA"
API_KEY_MOVIL="REEMPLAZAR_CON_API_KEY_SEGURA"
